# Copy this file to ".env" for local development (never commit .env).
# On Render, add the same three values under Environment instead.

# Neon dashboard -> Connect -> choose "Pooled connection" -> copy the string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# At least 8 characters. Used to sign in to the admin panel.
ADMIN_PASSWORD=change-me-please

# Websites allowed to call this API (comma separated, no trailing slash)
ALLOWED_ORIGINS=http://localhost:3000,https://your-shop.vercel.app

# Optional
# LOW_STOCK=10
# PORT=4000
